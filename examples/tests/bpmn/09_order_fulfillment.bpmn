<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_OrderFulfillment"
  targetNamespace="http://bpmn.io/schema/bpmn"
  exporter="Camunda Modeler"
  exporterVersion="5.46.1">

  <!--
    SOURCE: https://camunda.com/bpmn/reference/
    SCENARIO: Simple order fulfillment pipeline — validate, pay, ship.
    FEATURES TESTED: History API (suites 09)
  -->

  <bpmn:process id="orderFulfillment" name="Order Fulfillment" isExecutable="true" camunda:historyTimeToLive="30">

    <bpmn:startEvent id="start" name="Order Received">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="validateOrder" name="Validate Order"
        camunda:type="external" camunda:topic="validate-order">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:outgoing>sf2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="processPayment" name="Process Payment"
        camunda:type="external" camunda:topic="process-payment">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:outgoing>sf3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="shipOrder" name="Ship Order"
        camunda:type="external" camunda:topic="ship-order">
      <bpmn:incoming>sf3</bpmn:incoming>
      <bpmn:outgoing>sf4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="end" name="Order Fulfilled">
      <bpmn:incoming>sf4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="sf1" sourceRef="start"         targetRef="validateOrder"/>
    <bpmn:sequenceFlow id="sf2" sourceRef="validateOrder"  targetRef="processPayment"/>
    <bpmn:sequenceFlow id="sf3" sourceRef="processPayment" targetRef="shipOrder"/>
    <bpmn:sequenceFlow id="sf4" sourceRef="shipOrder"      targetRef="end"/>

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="orderFulfillment">

      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="152" y="252" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="132" y="295" width="76" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="validateOrder_di" bpmnElement="validateOrder">
        <dc:Bounds x="250" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="processPayment_di" bpmnElement="processPayment">
        <dc:Bounds x="420" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shipOrder_di" bpmnElement="shipOrder">
        <dc:Bounds x="590" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="762" y="252" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="742" y="295" width="76" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="sf1_di" bpmnElement="sf1">
        <di:waypoint x="188" y="270" /><di:waypoint x="250" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf2_di" bpmnElement="sf2">
        <di:waypoint x="350" y="270" /><di:waypoint x="420" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf3_di" bpmnElement="sf3">
        <di:waypoint x="520" y="270" /><di:waypoint x="590" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf4_di" bpmnElement="sf4">
        <di:waypoint x="690" y="270" /><di:waypoint x="762" y="270" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
