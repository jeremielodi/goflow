<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_CreditCheck"
  targetNamespace="http://bpmn.io/schema/bpmn"
  exporter="Camunda Modeler"
  exporterVersion="5.46.1">

  <!--
    SOURCE: https://camunda.com/bpmn/reference/ — Call Activity (sub-process)
    SCENARIO: Reusable credit check sub-process. Called by loanApplication via
              a Call Activity. Retrieves the credit score, evaluates the risk,
              then ends — signalling the parent that it can continue.
    FEATURES TESTED: Call Activity child process (suite 13)
  -->

  <bpmn:process id="creditCheckProcess" name="Credit Check Process" isExecutable="true" camunda:historyTimeToLive="30">

    <bpmn:startEvent id="start" name="Credit Check Started">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="retrieveCreditScore" name="Retrieve Credit Score"
        camunda:type="external" camunda:topic="retrieve-credit-score">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:outgoing>sf2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="evaluateRisk" name="Evaluate Risk"
        camunda:type="external" camunda:topic="evaluate-risk">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:outgoing>sf3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="end" name="Credit Check Completed">
      <bpmn:incoming>sf3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="sf1" sourceRef="start"               targetRef="retrieveCreditScore"/>
    <bpmn:sequenceFlow id="sf2" sourceRef="retrieveCreditScore" targetRef="evaluateRisk"/>
    <bpmn:sequenceFlow id="sf3" sourceRef="evaluateRisk"        targetRef="end"/>

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="creditCheckProcess">

      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="152" y="252" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="126" y="295" width="88" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="retrieveCreditScore_di" bpmnElement="retrieveCreditScore">
        <dc:Bounds x="250" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evaluateRisk_di" bpmnElement="evaluateRisk">
        <dc:Bounds x="420" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="592" y="252" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="566" y="295" width="88" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="sf1_di" bpmnElement="sf1">
        <di:waypoint x="188" y="270" /><di:waypoint x="250" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf2_di" bpmnElement="sf2">
        <di:waypoint x="350" y="270" /><di:waypoint x="420" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf3_di" bpmnElement="sf3">
        <di:waypoint x="520" y="270" /><di:waypoint x="592" y="270" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
