<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  id="Definitions_SingleTaskProcess"
  targetNamespace="http://bpmn.io/schema/bpmn"
  exporter="Camunda Modeler"
  exporterVersion="5.46.1">

  <!--
    SCENARIO: Suite 27's fixture for Phase 1 of the event-sourced engine
              (see architecture/event-sourced-kafka-design.md) — the only
              BPMN shape the partitioned write path supports so far: one
              start event, one external service task, one end event, in a
              single linear chain. Deliberately as minimal as
              24_grpc_process.bpmn, kept as a separate fixture so this
              suite doesn't depend on another suite's process key staying
              write_path=legacy forever.
  -->

  <bpmn:process id="SingleTaskProcess" name="Single Task Process" isExecutable="true">

    <bpmn:startEvent id="start" name="Started">
      <bpmn:outgoing>Flow_Start_Task</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="processItem" name="Process Item">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="process-item" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Task</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="end" name="Done">
      <bpmn:incoming>Flow_Task_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Task" sourceRef="start" targetRef="processItem" />
    <bpmn:sequenceFlow id="Flow_Task_End" sourceRef="processItem" targetRef="end" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_SingleTaskProcess">
    <bpmndi:BPMNPlane id="BPMNPlane_SingleTaskProcess" bpmnElement="SingleTaskProcess">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="152" y="252" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="processItem_di" bpmnElement="processItem">
        <dc:Bounds x="240" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="400" y="252" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Task_di" bpmnElement="Flow_Start_Task">
        <di:waypoint x="188" y="270" /><di:waypoint x="240" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task_End_di" bpmnElement="Flow_Task_End">
        <di:waypoint x="340" y="270" /><di:waypoint x="400" y="270" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
