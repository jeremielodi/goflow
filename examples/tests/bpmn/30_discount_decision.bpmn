<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  id="Definitions_DiscountChainProcess"
  targetNamespace="http://bpmn.io/schema/bpmn"
  exporter="Camunda Modeler"
  exporterVersion="5.46.1">

  <!--
    SCENARIO: Suite 30's fixture for Phase 4 of the event-sourced engine
              (see architecture/event-sourced-kafka-design.md) — a business
              rule task (DMN zeebe:calledDecision) evaluated synchronously
              inline, feeding its result into a following external service
              task, proving the partitioned write path's linear chain can
              mix task types, not just chain multiple service tasks.
  -->

  <bpmn:process id="DiscountChainProcess" name="Discount Chain Process" isExecutable="true">

    <bpmn:startEvent id="start" name="Order Submitted">
      <bpmn:outgoing>Flow_Start_Evaluate</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:businessRuleTask id="evaluateDiscount" name="Evaluate Discount">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="discountDecision" resultVariable="discountResult" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Evaluate</bpmn:incoming>
      <bpmn:outgoing>Flow_Evaluate_Apply</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:serviceTask id="applyDiscount" name="Apply Discount">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="process-apply-discount" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Evaluate_Apply</bpmn:incoming>
      <bpmn:outgoing>Flow_Apply_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="end" name="Done">
      <bpmn:incoming>Flow_Apply_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Evaluate" sourceRef="start" targetRef="evaluateDiscount" />
    <bpmn:sequenceFlow id="Flow_Evaluate_Apply" sourceRef="evaluateDiscount" targetRef="applyDiscount" />
    <bpmn:sequenceFlow id="Flow_Apply_End" sourceRef="applyDiscount" targetRef="end" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_DiscountChainProcess">
    <bpmndi:BPMNPlane id="BPMNPlane_DiscountChainProcess" bpmnElement="DiscountChainProcess">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="152" y="252" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evaluateDiscount_di" bpmnElement="evaluateDiscount">
        <dc:Bounds x="240" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="applyDiscount_di" bpmnElement="applyDiscount">
        <dc:Bounds x="400" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="560" y="252" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Evaluate_di" bpmnElement="Flow_Start_Evaluate">
        <di:waypoint x="188" y="270" /><di:waypoint x="240" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Evaluate_Apply_di" bpmnElement="Flow_Evaluate_Apply">
        <di:waypoint x="340" y="270" /><di:waypoint x="400" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Apply_End_di" bpmnElement="Flow_Apply_End">
        <di:waypoint x="500" y="270" /><di:waypoint x="560" y="270" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
