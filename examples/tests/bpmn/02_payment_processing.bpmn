<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_PaymentProcess"
  targetNamespace="http://bpmn.io/schema/bpmn"
  exporter="Camunda Modeler"
  exporterVersion="5.46.1">

  <!--
    TEST COVERAGE:
      - Service Task / External Worker (topic: validate_payment, process_payment, send_receipt)
      - External task fetchAndLock / complete / failure with retry
      - Exclusive Gateway driven by worker-set variable (valid)
      - Sequential service task chain
  -->
  <bpmn:process id="PaymentProcess" name="Payment Processing" isExecutable="true" camunda:historyTimeToLive="30">

    <bpmn:startEvent id="StartEvent_Pay" name="Payment Requested">
      <bpmn:outgoing>Flow_Start_Validate</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Step 1: Validate payment data -->
    <bpmn:serviceTask id="validate_payment" name="Validate Payment" camunda:type="external" camunda:topic="validate_payment">
      <bpmn:incoming>Flow_Start_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- XOR: payment valid? -->
    <bpmn:exclusiveGateway id="validation_gateway" name="Valid?">
      <bpmn:incoming>Flow_Validate_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid_Process</bpmn:outgoing>
      <bpmn:outgoing>Flow_Invalid_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Step 2 (valid path): Process payment -->
    <bpmn:serviceTask id="process_payment" name="Process Payment" camunda:type="external" camunda:topic="process_payment">
      <bpmn:incoming>Flow_Valid_Process</bpmn:incoming>
      <bpmn:outgoing>Flow_Process_Receipt</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Step 3: Send receipt -->
    <bpmn:serviceTask id="send_receipt" name="Send Receipt" camunda:type="external" camunda:topic="send_receipt">
      <bpmn:incoming>Flow_Process_Receipt</bpmn:incoming>
      <bpmn:outgoing>Flow_Receipt_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="end_payment_success" name="Payment Complete">
      <bpmn:incoming>Flow_Receipt_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="end_payment_failed" name="Validation Failed">
      <bpmn:incoming>Flow_Invalid_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Validate" sourceRef="StartEvent_Pay" targetRef="validate_payment" />
    <bpmn:sequenceFlow id="Flow_Validate_Gateway" sourceRef="validate_payment" targetRef="validation_gateway" />
    <bpmn:sequenceFlow id="Flow_Valid_Process" sourceRef="validation_gateway" targetRef="process_payment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${valid == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Process_Receipt" sourceRef="process_payment" targetRef="send_receipt" />
    <bpmn:sequenceFlow id="Flow_Receipt_End" sourceRef="send_receipt" targetRef="end_payment_success" />
    <bpmn:sequenceFlow id="Flow_Invalid_End" sourceRef="validation_gateway" targetRef="end_payment_failed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${valid == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_PaymentProcess">
    <bpmndi:BPMNPlane id="BPMNPlane_PaymentProcess" bpmnElement="PaymentProcess">

      <bpmndi:BPMNShape id="StartEvent_Pay_di" bpmnElement="StartEvent_Pay">
        <dc:Bounds x="152" y="159" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="125" y="202" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="validate_payment_di" bpmnElement="validate_payment">
        <dc:Bounds x="250" y="137" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="validation_gateway_di" bpmnElement="validation_gateway" isMarkerVisible="true">
        <dc:Bounds x="415" y="152" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="420" y="122" width="40" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="process_payment_di" bpmnElement="process_payment">
        <dc:Bounds x="530" y="137" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="send_receipt_di" bpmnElement="send_receipt">
        <dc:Bounds x="700" y="137" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="end_payment_success_di" bpmnElement="end_payment_success">
        <dc:Bounds x="872" y="159" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="849" y="202" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="end_payment_failed_di" bpmnElement="end_payment_failed">
        <dc:Bounds x="422" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="399" y="345" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_Start_Validate_di" bpmnElement="Flow_Start_Validate">
        <di:waypoint x="188" y="177" />
        <di:waypoint x="250" y="177" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Validate_Gateway_di" bpmnElement="Flow_Validate_Gateway">
        <di:waypoint x="350" y="177" />
        <di:waypoint x="415" y="177" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Valid_Process_di" bpmnElement="Flow_Valid_Process">
        <di:waypoint x="465" y="177" />
        <di:waypoint x="530" y="177" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Process_Receipt_di" bpmnElement="Flow_Process_Receipt">
        <di:waypoint x="630" y="177" />
        <di:waypoint x="700" y="177" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Receipt_End_di" bpmnElement="Flow_Receipt_End">
        <di:waypoint x="800" y="177" />
        <di:waypoint x="872" y="177" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Invalid_End_di" bpmnElement="Flow_Invalid_End">
        <di:waypoint x="440" y="202" />
        <di:waypoint x="440" y="302" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
