<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  id="Definitions_BoundaryErrorChainProcess"
  targetNamespace="http://bpmn.io/schema/bpmn"
  exporter="Camunda Modeler"
  exporterVersion="5.46.1">

  <!--
    SCENARIO: Suite 31's fixture for Phase 5 of the event-sourced engine
              (see architecture/event-sourced-kafka-design.md) — a single
              service task with an attached error boundary event, whose
              own outgoing flow rejoins the same shared end event as the
              normal path (this validator's smallest possible integration:
              no sub-chain from the boundary). Proves the partitioned
              engine's FailJob command can trigger a boundary event and
              correctly resume execution from there.
  -->

  <bpmn:error id="Error_RiskFailed" name="Risk Failed" errorCode="RISK_ERROR" />

  <bpmn:process id="BoundaryErrorChainProcess" name="Boundary Error Chain Process" isExecutable="true">

    <bpmn:startEvent id="start" name="Started">
      <bpmn:outgoing>Flow_Start_Risky</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="riskyTask" name="Risky Task">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="process-risky-task" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Risky</bpmn:incoming>
      <bpmn:outgoing>Flow_Risky_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:boundaryEvent id="onError" attachedToRef="riskyTask" cancelActivity="true">
      <bpmn:errorEventDefinition id="ErrorDef_1" errorRef="Error_RiskFailed" />
      <bpmn:outgoing>Flow_Error_End</bpmn:outgoing>
    </bpmn:boundaryEvent>

    <bpmn:endEvent id="end" name="Done">
      <bpmn:incoming>Flow_Risky_End</bpmn:incoming>
      <bpmn:incoming>Flow_Error_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Risky" sourceRef="start" targetRef="riskyTask" />
    <bpmn:sequenceFlow id="Flow_Risky_End" sourceRef="riskyTask" targetRef="end" />
    <bpmn:sequenceFlow id="Flow_Error_End" sourceRef="onError" targetRef="end" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_BoundaryErrorChainProcess">
    <bpmndi:BPMNPlane id="BPMNPlane_BoundaryErrorChainProcess" bpmnElement="BoundaryErrorChainProcess">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="152" y="252" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="riskyTask_di" bpmnElement="riskyTask">
        <dc:Bounds x="240" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="onError_di" bpmnElement="onError">
        <dc:Bounds x="272" y="292" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="420" y="252" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Risky_di" bpmnElement="Flow_Start_Risky">
        <di:waypoint x="188" y="270" /><di:waypoint x="240" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Risky_End_di" bpmnElement="Flow_Risky_End">
        <di:waypoint x="340" y="270" /><di:waypoint x="420" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Error_End_di" bpmnElement="Flow_Error_End">
        <di:waypoint x="290" y="328" /><di:waypoint x="290" y="400" /><di:waypoint x="438" y="400" /><di:waypoint x="438" y="288" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
