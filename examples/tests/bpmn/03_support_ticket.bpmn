<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_SupportTicket"
  targetNamespace="http://bpmn.io/schema/bpmn"
  exporter="Camunda Modeler"
  exporterVersion="5.46.1">

  <!--
    TEST COVERAGE:
      - Boundary Timer Event (interrupting, PT15S) attached to User Task
      - User Task with candidateGroups (no pre-assigned user)
      - Service Task on timer-triggered escalation path
      - Two different End Events (normal vs escalated)
  -->
  <bpmn:process id="SupportTicketProcess" name="Support Ticket Process" isExecutable="true" camunda:historyTimeToLive="30">

    <bpmn:startEvent id="StartEvent_Ticket" name="Ticket Opened">
      <bpmn:outgoing>Flow_Start_Resolve</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Agent must resolve within 15 seconds or escalation fires -->
    <bpmn:userTask id="resolve_ticket" name="Resolve Ticket" camunda:candidateGroups="support">
      <bpmn:incoming>Flow_Start_Resolve</bpmn:incoming>
      <bpmn:outgoing>Flow_Resolve_End</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Boundary timer: fires after PT15S if ticket not resolved -->
    <bpmn:boundaryEvent id="timer_escalate" name="15s SLA" attachedToRef="resolve_ticket" cancelActivity="true">
      <bpmn:outgoing>Flow_Timer_Escalate</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Escalate">
        <bpmn:timeDuration>PT15S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <!-- Escalation path: notify L2 team -->
    <bpmn:serviceTask id="escalate_ticket" name="Escalate to L2" camunda:type="external" camunda:topic="escalate_ticket">
      <bpmn:incoming>Flow_Timer_Escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_Escalate_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="end_resolved" name="Ticket Resolved">
      <bpmn:incoming>Flow_Resolve_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="end_escalated" name="Ticket Escalated">
      <bpmn:incoming>Flow_Escalate_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Resolve" sourceRef="StartEvent_Ticket" targetRef="resolve_ticket" />
    <bpmn:sequenceFlow id="Flow_Resolve_End" sourceRef="resolve_ticket" targetRef="end_resolved" />
    <bpmn:sequenceFlow id="Flow_Timer_Escalate" sourceRef="timer_escalate" targetRef="escalate_ticket" />
    <bpmn:sequenceFlow id="Flow_Escalate_End" sourceRef="escalate_ticket" targetRef="end_escalated" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_SupportTicket">
    <bpmndi:BPMNPlane id="BPMNPlane_SupportTicket" bpmnElement="SupportTicketProcess">

      <bpmndi:BPMNShape id="StartEvent_Ticket_di" bpmnElement="StartEvent_Ticket">
        <dc:Bounds x="152" y="119" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="130" y="162" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="resolve_ticket_di" bpmnElement="resolve_ticket">
        <dc:Bounds x="250" y="97" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <!-- Boundary timer sits at the bottom edge of the user task -->
      <bpmndi:BPMNShape id="timer_escalate_di" bpmnElement="timer_escalate">
        <dc:Bounds x="282" y="159" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="270" y="202" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="escalate_ticket_di" bpmnElement="escalate_ticket">
        <dc:Bounds x="250" y="270" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="end_resolved_di" bpmnElement="end_resolved">
        <dc:Bounds x="422" y="119" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="400" y="162" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="end_escalated_di" bpmnElement="end_escalated">
        <dc:Bounds x="422" y="292" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="400" y="335" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_Start_Resolve_di" bpmnElement="Flow_Start_Resolve">
        <di:waypoint x="188" y="137" />
        <di:waypoint x="250" y="137" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Resolve_End_di" bpmnElement="Flow_Resolve_End">
        <di:waypoint x="350" y="137" />
        <di:waypoint x="422" y="137" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Timer_Escalate_di" bpmnElement="Flow_Timer_Escalate">
        <di:waypoint x="300" y="195" />
        <di:waypoint x="300" y="270" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Escalate_End_di" bpmnElement="Flow_Escalate_End">
        <di:waypoint x="350" y="310" />
        <di:waypoint x="422" y="310" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
