<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_DiamondDivergingEnds"
  targetNamespace="http://bpmn.io/schema/bpmn"
  exporter="Camunda Modeler"
  exporterVersion="5.46.1">

  <!--
    SCENARIO: Suite 28's negative fixture proving internal/partition.
              ValidateShape's shared-end connectivity check works, not just
              its node-type bucketing: this graph uses only node types the
              partitioned engine otherwise allows (start, exclusiveGateway,
              serviceTask, endEvent), but the two branches end at two
              separate end events instead of converging, and must still be
              rejected.
  -->

  <bpmn:process id="DiamondDivergingEnds" name="Diamond Diverging Ends" isExecutable="true">

    <bpmn:startEvent id="start" name="Started">
      <bpmn:outgoing>Flow_Start_Gateway</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:exclusiveGateway id="decision" name="Branch?">
      <bpmn:incoming>Flow_Start_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_A</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_B</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="taskA" name="Process Branch A">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="process-branch-a" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gateway_A</bpmn:incoming>
      <bpmn:outgoing>Flow_A_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="taskB" name="Process Branch B">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="process-branch-b" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gateway_B</bpmn:incoming>
      <bpmn:outgoing>Flow_B_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="endA" name="Done A">
      <bpmn:incoming>Flow_A_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="endB" name="Done B">
      <bpmn:incoming>Flow_B_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Gateway" sourceRef="start" targetRef="decision" />
    <bpmn:sequenceFlow id="Flow_Gateway_A" sourceRef="decision" targetRef="taskA">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${branch == "a"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_B" sourceRef="decision" targetRef="taskB">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${branch == "b"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A_End" sourceRef="taskA" targetRef="endA" />
    <bpmn:sequenceFlow id="Flow_B_End" sourceRef="taskB" targetRef="endB" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_DiamondDivergingEnds">
    <bpmndi:BPMNPlane id="BPMNPlane_DiamondDivergingEnds" bpmnElement="DiamondDivergingEnds">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="152" y="252" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="decision_di" bpmnElement="decision">
        <dc:Bounds x="245" y="245" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="taskA_di" bpmnElement="taskA">
        <dc:Bounds x="360" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="taskB_di" bpmnElement="taskB">
        <dc:Bounds x="360" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endA_di" bpmnElement="endA">
        <dc:Bounds x="530" y="172" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endB_di" bpmnElement="endB">
        <dc:Bounds x="530" y="342" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Gateway_di" bpmnElement="Flow_Start_Gateway">
        <di:waypoint x="188" y="270" /><di:waypoint x="245" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_A_di" bpmnElement="Flow_Gateway_A">
        <di:waypoint x="270" y="245" /><di:waypoint x="270" y="190" /><di:waypoint x="360" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_B_di" bpmnElement="Flow_Gateway_B">
        <di:waypoint x="270" y="295" /><di:waypoint x="270" y="360" /><di:waypoint x="360" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A_End_di" bpmnElement="Flow_A_End">
        <di:waypoint x="460" y="190" /><di:waypoint x="530" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B_End_di" bpmnElement="Flow_B_End">
        <di:waypoint x="460" y="360" /><di:waypoint x="530" y="360" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
