<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_SupportTicket"
  targetNamespace="http://bpmn.io/schema/bpmn"
  exporter="Camunda Modeler"
  exporterVersion="5.46.1">

  <!--
    SOURCE: https://camunda.com/bpmn/reference/ — External Task / Incident example
    SCENARIO: A support ticket is created, then an external worker classifies it.
              If the worker fails permanently (retries exhausted, no error boundary),
              an incident is raised. The incident can be resolved by resetting retries
              so the job can be retried and the process continues.

    FEATURES TESTED:
      - Incident creation on permanent job failure (no matching error boundary)
      - GET /engine-rest/incident — list open incidents
      - GET /engine-rest/process-instance/:id/incidents — incidents scoped to instance
      - POST /engine-rest/job/:id/retries — retry failed job + resolve incident
      - DELETE /engine-rest/incident/:id — delete an incident
  -->

  <bpmn:process id="SupportTicketProcess" name="Support Ticket with Incident" isExecutable="true" camunda:historyTimeToLive="30">

    <bpmn:startEvent id="start" name="Ticket Created">
      <bpmn:outgoing>Flow_Start_Classify</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="classifyTicket" name="Classify Ticket" camunda:type="external" camunda:topic="classify_ticket">
      <bpmn:incoming>Flow_Start_Classify</bpmn:incoming>
      <bpmn:outgoing>Flow_Classify_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="end" name="Ticket Classified">
      <bpmn:incoming>Flow_Classify_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Classify" sourceRef="start"         targetRef="classifyTicket" />
    <bpmn:sequenceFlow id="Flow_Classify_End"   sourceRef="classifyTicket" targetRef="end" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_SupportTicket">
    <bpmndi:BPMNPlane id="BPMNPlane_SupportTicket" bpmnElement="SupportTicketProcess">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="152" y="252" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="classifyTicket_di" bpmnElement="classifyTicket">
        <dc:Bounds x="250" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="422" y="252" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Classify_di" bpmnElement="Flow_Start_Classify">
        <di:waypoint x="188" y="270" /><di:waypoint x="250" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Classify_End_di" bpmnElement="Flow_Classify_End">
        <di:waypoint x="350" y="270" /><di:waypoint x="422" y="270" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
