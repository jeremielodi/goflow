<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_TimerExample" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd">
  <bpmn:process id="PurchaseOrderProcessWithTimer" name="Purchase Order Process with Timer" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="StartEvent_ReceivePO" name="Receive Purchase Order">
      <bpmn:outgoing>Flow_Start_Approval</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start_Approval" sourceRef="StartEvent_ReceivePO" targetRef="Task_Approval" />
    <bpmn:userTask id="Task_Approval" name="Approve Order" camunda:assignee="approver" camunda:dueDate="P3D">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="approved" label="Approve?" type="boolean" />
          <camunda:formField id="comments" label="Comments" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Approval</bpmn:incoming>
      <bpmn:outgoing>Flow_Approval_Gateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Approval_Gateway" sourceRef="Task_Approval" targetRef="Gateway_Approved" />
    <bpmn:boundaryEvent id="Timer_Escalate" name="30 seconds" attachedToRef="Task_Approval">
      <bpmn:outgoing>Flow_Timer_Escalate</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDef_3Days">
        <bpmn:timeDuration>PT10S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_Timer_Escalate" sourceRef="Timer_Escalate" targetRef="Task_Escalate" />
    <bpmn:serviceTask id="Task_Escalate" name="Escalate to Manager" camunda:type="external" camunda:topic="escalate_approval">
      <bpmn:incoming>Flow_Timer_Escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_Escalate_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Escalate_End" sourceRef="Task_Escalate" targetRef="EndEvent_Escalated" />
    <bpmn:endEvent id="EndEvent_Escalated" name="Escalated">
      <bpmn:incoming>Flow_Escalate_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Approved?">
      <bpmn:incoming>Flow_Approval_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved_Process</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ProcessOrder" name="Process Order" camunda:type="external" camunda:topic="process_order">
      <bpmn:incoming>Flow_Approved_Process</bpmn:incoming>
      <bpmn:outgoing>Flow_Process_Complete</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Approved_Process" sourceRef="Gateway_Approved" targetRef="Task_ProcessOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="EndEvent_Complete" name="Order Complete">
      <bpmn:incoming>Flow_Process_Complete</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Process_Complete" sourceRef="Task_ProcessOrder" targetRef="EndEvent_Complete" />
    <bpmn:endEvent id="EndEvent_Rejected" name="Order Rejected">
      <bpmn:incoming>Flow_Rejected_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Rejected_End" sourceRef="Gateway_Approved" targetRef="EndEvent_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_TimerExample">
    <bpmndi:BPMNPlane id="BPMNPlane_TimerExample" bpmnElement="PurchaseOrderProcessWithTimer">
      <bpmndi:BPMNShape id="StartEvent_ReceivePO_di" bpmnElement="StartEvent_ReceivePO">
        <dc:Bounds x="100" y="80" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="80" y="123" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Approval_di" bpmnElement="Task_Approval">
        <dc:Bounds x="200" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Approved_di" bpmnElement="Gateway_Approved" isMarkerVisible="true">
        <dc:Bounds x="360" y="75" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="358" y="51" width="54" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ProcessOrder_di" bpmnElement="Task_ProcessOrder">
        <dc:Bounds x="480" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Complete_di" bpmnElement="EndEvent_Complete">
        <dc:Bounds x="650" y="80" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="634" y="123" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Rejected_di" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="650" y="200" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="634" y="243" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Escalate_di" bpmnElement="Task_Escalate">
        <dc:Bounds x="180" y="240" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Escalated_di" bpmnElement="EndEvent_Escalated">
        <dc:Bounds x="412" y="275" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="402" y="318" width="49" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_Escalate_di" bpmnElement="Timer_Escalate">
        <dc:Bounds x="222" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="212" y="165" width="57" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Approval_di" bpmnElement="Flow_Start_Approval">
        <di:waypoint x="136" y="98" />
        <di:waypoint x="200" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approval_Gateway_di" bpmnElement="Flow_Approval_Gateway">
        <di:waypoint x="300" y="100" />
        <di:waypoint x="360" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Timer_Escalate_di" bpmnElement="Flow_Timer_Escalate">
        <di:waypoint x="240" y="158" />
        <di:waypoint x="240" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Escalate_End_di" bpmnElement="Flow_Escalate_End">
        <di:waypoint x="300" y="290" />
        <di:waypoint x="412" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approved_Process_di" bpmnElement="Flow_Approved_Process">
        <di:waypoint x="410" y="100" />
        <di:waypoint x="480" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Process_Complete_di" bpmnElement="Flow_Process_Complete">
        <di:waypoint x="580" y="100" />
        <di:waypoint x="650" y="98" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Rejected_End_di" bpmnElement="Flow_Rejected_End">
        <di:waypoint x="385" y="125" />
        <di:waypoint x="385" y="218" />
        <di:waypoint x="650" y="218" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
