<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_PurchaseProcess" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1">
  <bpmn:message id="Message_NotifySupervisor" name="notify_supervisor" />
  <bpmn:message id="Message_NotifyApprover" name="notify_approver" />
  <bpmn:message id="Message_NotifyAccountant" name="notify_accountant" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Requester" name="Requester (Employee)" processRef="prf_process_requester" />
    <bpmn:participant id="Participant_Supervisor" name="Supervisor" processRef="prf_process_supervisor" />
    <bpmn:participant id="Participant_Approver" name="Approver / Budget Holder" processRef="prf_process_approver" />
    <bpmn:participant id="Participant_Accountant" name="Accountant" processRef="prf_process_accountant" />
    <bpmn:messageFlow id="Flow_13dxsqd" sourceRef="Task_SystemNotifyApprover" targetRef="Event_ApproverNotifReceived" />
    <bpmn:messageFlow id="Flow_1fd1muj" sourceRef="Task_SystemNotifyAccountant" targetRef="Event_AccountantNotifReceived" />
    <bpmn:messageFlow id="Flow_0lvgyf3" sourceRef="Task_SystemNotifySupervisor" targetRef="supervisor_receive_message" />
  </bpmn:collaboration>
  <bpmn:process id="prf_process_requester" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="StartEvent_Requester" name="Start">
      <bpmn:outgoing>Flow_R1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_CreatePRF" name="create_PRF" camunda:formKey="">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_R1</bpmn:incoming>
      <bpmn:outgoing>Flow_R2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SignPRF" name="Sign_PRF" camunda:assignee="${maker_name}">
      <bpmn:incoming>Flow_R2</bpmn:incoming>
      <bpmn:outgoing>Flow_0be263b</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_R1" sourceRef="StartEvent_Requester" targetRef="Task_CreatePRF" />
    <bpmn:sequenceFlow id="Flow_R2" sourceRef="Task_CreatePRF" targetRef="Task_SignPRF" />
    <bpmn:sequenceFlow id="Flow_0be263b" sourceRef="Task_SignPRF" targetRef="Task_SystemNotifySupervisor" />
    <bpmn:serviceTask id="Task_SystemNotifySupervisor" name="Send notification&#10;to Supervisor&#10;notify-supervisor" camunda:type="external" camunda:topic="prf_notify_supervisor">
      <bpmn:incoming>Flow_0be263b</bpmn:incoming>
    </bpmn:serviceTask>
  </bpmn:process>
  <bpmn:process id="prf_process_supervisor" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:extensionElements />
    <bpmn:sequenceFlow id="Flow_1ivmk71" sourceRef="Gateway_Supervisor" targetRef="Task_SystemNotifyApprover">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${supervisor_reviewed == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S4_False" name="supervisorApproved = false" sourceRef="Gateway_Supervisor" targetRef="EndEvent_SupervisorReject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${supervisor_reviewed == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S3" sourceRef="Task_SupervisorReview" targetRef="Gateway_Supervisor" />
    <bpmn:sequenceFlow id="Flow_09ies2c" sourceRef="supervisor_receive_message" targetRef="Task_SupervisorReview" />
    <bpmn:serviceTask id="Task_SystemNotifyApprover" name="Send notification&#10;to Approver&#10;notify-approver" camunda:type="external" camunda:topic="prf_notify_approver">
      <bpmn:incoming>Flow_1ivmk71</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_SupervisorReject" name="End">
      <bpmn:incoming>Flow_S4_False</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_Supervisor" name="supervisorApproved?">
      <bpmn:incoming>Flow_S3</bpmn:incoming>
      <bpmn:outgoing>Flow_S4_False</bpmn:outgoing>
      <bpmn:outgoing>Flow_1ivmk71</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_SupervisorReview" name="supervisor_review" camunda:assignee="${supervisor}">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="supervisor_reviewed" label="supervisor revision" type="boolean" />
          <camunda:formField id="supervisor_comments" label="supervisor comments" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09ies2c</bpmn:incoming>
      <bpmn:outgoing>Flow_S3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="supervisor_receive_message" name="System notification received&#10;(from System)" camunda:formKey="">
      <bpmn:extensionElements />
      <bpmn:outgoing>Flow_09ies2c</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1ky8uz5" messageRef="Message_02jr1h8" />
    </bpmn:startEvent>
  </bpmn:process>
  <bpmn:process id="prf_process_approver" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:userTask id="Task_ApproverApproved" name="approver_approved" camunda:assignee="${approver}">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="approver_approved" label="approver approval" type="boolean" />
          <camunda:formField id="approver_comments" label="approver comments" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A2</bpmn:incoming>
      <bpmn:outgoing>Flow_A3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_ApproverReject" name="End">
      <bpmn:incoming>Flow_A4_False</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Event_ApproverNotifReceived" name="System notification received&#10;(from System)" camunda:formKey="">
      <bpmn:outgoing>Flow_A2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_02nyhnp" messageRef="Message_2ajvqhi" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_A3" sourceRef="Task_ApproverApproved" targetRef="Gateway_Approver" />
    <bpmn:sequenceFlow id="Flow_A4_False" name="rejected" sourceRef="Gateway_Approver" targetRef="EndEvent_ApproverReject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approver_approved == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0y96fwk" sourceRef="Gateway_Approver" targetRef="Task_SystemNotifyAccountant">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approver_approved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A2" sourceRef="Event_ApproverNotifReceived" targetRef="Task_ApproverApproved" />
    <bpmn:exclusiveGateway id="Gateway_Approver" name="approverApproved?">
      <bpmn:incoming>Flow_A3</bpmn:incoming>
      <bpmn:outgoing>Flow_A4_False</bpmn:outgoing>
      <bpmn:outgoing>Flow_0y96fwk</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SystemNotifyAccountant" name="Send notification&#10;to Accountant&#10;notify-accountant" camunda:type="external" camunda:topic="prf_notify_accountant">
      <bpmn:incoming>Flow_0y96fwk</bpmn:incoming>
    </bpmn:serviceTask>
  </bpmn:process>
  <bpmn:process id="prf_process_accountant" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:exclusiveGateway id="Gateway_Accountant" name="accountantApproved?">
      <bpmn:incoming>Flow_AC3</bpmn:incoming>
      <bpmn:outgoing>Flow_AC4_True</bpmn:outgoing>
      <bpmn:outgoing>Flow_AC4_False</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_AccountantReject" name="End">
      <bpmn:incoming>Flow_AC4_False</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_AccountantApprove" name="End">
      <bpmn:incoming>Flow_AC4_True</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_AccountantPay" name="accountant_pay" camunda:assignee="${accountant}">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="accountant_approved" label="payment approval" type="boolean" />
          <camunda:formField id="transaction_id" label="transaction id" type="string" />
          <camunda:formField id="payment_comments" label="payment comments" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AC2</bpmn:incoming>
      <bpmn:outgoing>Flow_AC3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_AC3" sourceRef="Task_AccountantPay" targetRef="Gateway_Accountant" />
    <bpmn:sequenceFlow id="Flow_AC4_True" name="paid" sourceRef="Gateway_Accountant" targetRef="EndEvent_AccountantApprove">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${accountant_approved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AC4_False" name="rejected" sourceRef="Gateway_Accountant" targetRef="EndEvent_AccountantReject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${accountant_approved == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AC2" sourceRef="Event_AccountantNotifReceived" targetRef="Task_AccountantPay" />
    <bpmn:startEvent id="Event_AccountantNotifReceived" name="System notification received&#10;(from System)">
      <bpmn:outgoing>Flow_AC2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1ezc8zv" messageRef="Message_3n3d73p" />
    </bpmn:startEvent>
  </bpmn:process>
  <bpmn:message id="Message_02jr1h8" name="supervisor_receive_message" />
  <bpmn:message id="Message_04rei5r" name="approver" />
  <bpmn:message id="Message_2ajvqhi" name="approver_receive_message" />
  <bpmn:message id="Message_3n3d73p" name="accountant_receive_message" />
