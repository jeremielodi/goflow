DB_HOST='localhost'
DB_USER='camunda'
DB_PASS='camunda'
DB_NAME='goflow'
DB_PORT=5432
# SSL vers Postgres : disable (défaut), require, verify-ca, verify-full
# DB_SSLMODE=require
# Mot de passe du Postgres dockerisé (docker compose) — goflow123 par défaut
# POSTGRES_PASSWORD=change_me
SERVER_PATH='http://127.0.0.1:8080'
PORT='8080'

CLIENT_DEV_PORT='8282'

# Queue Settings
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_BACKOFF_BASE=1s
QUEUE_RETRY_MAX_BACKOFF=5m
QUEUE_RETRY_SCHEDULER_INTERVAL=5s
QUEUE_STATS_UPDATE_INTERVAL=30s
QUEUE_CLEANUP_OLDER_THAN=24h

# Server Configuration
# SERVER_PORT : port de l'application (en local, et port publié par docker compose)
SERVER_PORT=8080
# FRONTEND_PORT : port publié du frontend dockerisé (nginx)
FRONTEND_PORT=3000
QUEUE_WORKERS=10

# Clé de signature des tokens — OBLIGATOIRE (le serveur refuse de démarrer
# sans elle, et refuse 'change_me' quand GOFLOW_ENV=production).
# Générer avec : openssl rand -base64 48
JWT_SECRET_KEY='change_me'

# Super User (créé au démarrage s'il n'existe pas — aussi utilisé par docker compose)
SUPER_USER_NAME=admin
SUPER_USER_EMAIL=admin@goflow.com
SUPER_USER_PASSWORD=change_me

# OIDC (optional) — set all three to accept bearer tokens from an external
# identity provider (Keycloak, Auth0, Azure AD, ...) alongside the built-in
# JWT login. Leave unset to keep OIDC disabled (default).
# OIDC_ISSUER=https://your-idp.example.com/realms/goflow
# OIDC_AUDIENCE=goflow-api
# OIDC_JWKS_URL=https://your-idp.example.com/realms/goflow/protocol/openid-connect/certs

# Observabilité — jeton exigé sur GET /metrics (Authorization: Bearer <jeton>).
# Vide = /metrics lisible sans authentification.
# METRICS_TOKEN=change_me

# Rétention — supprime automatiquement les instances terminées depuis plus de
# N jours (historic_*, audit_logs et projections liés). Vide ou 0 = tout garder.
# RETENTION_DAYS=365
# RETENTION_INTERVAL=1h
# RETENTION_BATCH_SIZE=500

# Kafka / Redpanda (docker compose)
# KAFKA_REPLICATION_FACTOR=1   # copies par partition, à la création des topics
# REDPANDA_MEMORY=1G
# REDPANDA_SMP=1
# POSTGRES_BIND=127.0.0.1      # 0.0.0.0 pour exposer Postgres hors de la machine

# Expressions FEEL (préfixe "=", style Camunda 8) et tables DMN :
#   shadow (défaut) — l'ancien moteur (traduction FEEL→CEL) décide, le moteur
#                     FEEL natif tourne en parallèle et chaque écart est
#                     journalisé + compté (goflow_feel_shadow_mismatches_total)
#   feel            — le moteur FEEL natif décide
#   cel             — ancien moteur seul
# FEEL_MODE=shadow

# Connexions Postgres : DB_MAX_OPEN_CONNS par instance GoFlow (défaut 80) ;
# POSTGRES_MAX_CONNECTIONS (défaut 200) doit couvrir DB_MAX_OPEN_CONNS × le
# nombre d'instances GoFlow, plus une marge pour l'admin.
# DB_MAX_OPEN_CONNS=80
# POSTGRES_MAX_CONNECTIONS=200
